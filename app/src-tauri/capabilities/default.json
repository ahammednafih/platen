{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:default",
    "dialog:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$HOME/**" }] }
  ]
}
