{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scan",
  "identifier": "app.scan.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Scan", "width": 1200, "height": 800, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; img-src 'self' scanimg: http://scanimg.localhost; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
